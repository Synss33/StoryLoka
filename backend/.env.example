# Salin file ini menjadi `.env` lalu isi nilainya. `.env` TIDAK boleh dikomit.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# API key LLM (Gemini) HANYA disimpan di server, tidak pernah ada di aplikasi.
GEMINI_API_KEY=

# Kurs mata uang (WF-05): provider publik tanpa API key, cache (ms),
# dan mode luring untuk pengujian (RATES_OFFLINE=1 memakai nilai statis).
RATES_PROVIDER_URL=https://open.er-api.com/v6/latest/IDR
RATES_TTL_MS=21600000
RATES_OFFLINE=0
